# Origem HTTPS exata da central. Sem caminho nem barra adicional.
APP_ORIGIN=https://acquarella-comunicacao.vercel.app
# Mesmo segredo privado configurado na Vercel (32+ caracteres aleatórios).
WHATSAPP_QR_SECRET=
# Chave independente de 32 bytes em base64. Preserve junto dos backups.
QR_STORAGE_KEY=
QR_DATA_DIR=./data
HOST=127.0.0.1
PORT=3100
NODE_ENV=production
