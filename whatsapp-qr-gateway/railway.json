{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "whatsapp-qr-gateway/Dockerfile",
    "watchPatterns": ["/whatsapp-qr-gateway/**", "/vercel-app/lib/qr-protocol.mjs", "/.dockerignore"]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ALWAYS"
  }
}
